{
  "name": "urscript-debugger",
  "displayName": "URScript Debugger",
  "description": "A real debugger for raw URScript (Universal Robots): breakpoints, stepping, live variable inspection and editing",
  "version": "0.2.0",
  "publisher": "DAEDALEautomation",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wankeur/urscript-debugger.git"
  },
  "keywords": [
    "urscript",
    "universal robots",
    "robot",
    "cobot",
    "debugger",
    "ursim"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebug",
    "onCommand:urscript-debugger.enterLicenseKey",
    "onCommand:urscript-debugger.clearLicenseKey"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "urscript-debugger.enterLicenseKey",
        "title": "URScript Debugger: Enter License Key"
      },
      {
        "command": "urscript-debugger.clearLicenseKey",
        "title": "URScript Debugger: Remove License Key"
      }
    ],
    "configuration": {
      "title": "URScript Debugger",
      "properties": {
        "urscript-debugger.licenseServerUrl": {
          "type": "string",
          "default": "",
          "description": "License validation server URL (leave empty during development; premium features stay locked without it unless a cached valid license exists)."
        },
        "urscript-debugger.__testForceLicensed": {
          "type": "boolean",
          "description": "Internal, used only by the E2E test suite to simulate a licensed/unlicensed state. Not meant to be set manually.",
          "scope": "application"
        }
      }
    },
    "breakpoints": [
      {
        "language": "urscript"
      }
    ],
    "languages": [
      {
        "id": "urscript",
        "extensions": [
          ".script"
        ],
        "aliases": [
          "URScript"
        ]
      }
    ],
    "debuggers": [
      {
        "type": "urscript",
        "label": "URScript Debug",
        "languages": [
          "urscript"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .script file to debug",
                "default": "${file}"
              },
              "ursimHost": {
                "type": "string",
                "description": "IP address of URSim or the robot controller",
                "default": "127.0.0.1"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "urscript",
            "request": "launch",
            "name": "Debug this URScript file",
            "program": "${file}",
            "ursimHost": "127.0.0.1"
          }
        ],
        "configurationSnippets": [
          {
            "label": "URScript: Debug against URSim",
            "body": {
              "type": "urscript",
              "request": "launch",
              "name": "Debug this URScript file",
              "program": "^\"\\${file}\"",
              "ursimHost": "127.0.0.1"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "copy-server": "node scripts/copy-server.js",
    "compile": "npm run copy-server && tsc -p ./",
    "watch": "npm run copy-server && tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.1",
    "typescript": "^5.4.0"
  }
}
