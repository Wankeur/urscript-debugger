{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "URScript",
  "scopeName": "source.urscript",
  "fileTypes": ["script"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.urscript",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.urscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.urscript", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.urscript",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.urscript", "match": "\\\\." }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.urscript",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b|\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.urscript",
          "match": "\\b(if|elif|else|while|for|return|break|continue|end)\\b"
        },
        {
          "name": "keyword.other.urscript",
          "match": "\\b(def|thread|global|local)\\b"
        },
        {
          "name": "keyword.operator.word.urscript",
          "match": "\\b(and|or|not|in)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.urscript",
          "match": "\\b(True|False)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.urscript",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.urscript",
          "match": "==|!=|<=|>=|<|>|=|\\+|-|\\*|/|%"
        }
      ]
    }
  }
}
